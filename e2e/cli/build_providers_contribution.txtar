# A providers entry contributing manifest metadata, a root it has no files
# for, and its Rego version (the policy uses v1 syntax without importing
# rego.v1).
exec opactl-with-providers build --config config.d/bundle.yml --data-dir tmp --non-interactive
! stderr .
! stdout .

exec tar xf bundles/app/bundle.tar.gz
exec jq -e '.rego_version == 1 and .metadata == {"example": {"version": "v1"}} and (.roots | sort) == ["authz", "lazy/remote"]' .manifest

-- config.d/bundle.yml --
bundles:
  app:
    object_storage:
      filesystem:
        path: bundles/app/bundle.tar.gz
    requirements:
    - source: app
sources:
  app:
    providers:
    - name: users
      type: e2e.files
      files:
        authz.rego: |
          package authz
          allow if input.user == "alice"
      contribution:
        metadata:
          example:
            version: v1
        roots: [lazy/remote]
        rego_version: 1
